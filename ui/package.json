{
  "name": "drydock-ui",
  "version": "1.8.0",
  "description": "Drydock dashboard — Vue 3 + Tailwind CSS 4 SPA",
  "repository": "CodesWhat/drydock",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "author": "CodesWhat",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run icons && npm run fonts && vite build",
    "preview": "vite preview",
    "icons": "node scripts/extract-icons.mjs",
    "fonts": "node scripts/extract-fonts.mjs",
    "format": "biome format --write .",
    "lint:fix": "biome check --fix .",
    "lint": "biome check .",
    "test:security": "node ./node_modules/vitest/vitest.mjs run tests/security/*.spec.ts --maxWorkers=1 --fileParallelism=false",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:mutation": "stryker run",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "iconify-icon": "3.0.4",
    "pinia": "3.0.4",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3",
    "vue": "3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@fontsource/comic-mono": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.1",
    "@iconify-json/fa6-brands": "1.2.6",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/iconoir": "1.2.12",
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/tabler": "1.2.42",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.9",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/compiler-core": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "glob": "^14.0.2",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.3",
    "js-cookie": "3.0.8",
    "minimatch": "^11.0.1",
    "picomatch": "4.0.7",
    "postcss": "8.5.31",
    "qs": "6.16.1",
    "yaml": "2.9.1",
    "@babel/core": "7.29.7",
    "undici": "7.30.1",
    "nanoid": "6.0.2",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "zod": "4.6.7",
    "serialize-javascript": "7.1.4"
  }
}
