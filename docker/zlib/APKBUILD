# Maintainer: CodesWhat <security@getdrydock.com>
# Based on Alpine 3.24 main/zlib, with the upstream CVE fix only.
pkgname=zlib
pkgver=1.3.2
pkgrel=2026092401
pkgdesc="A compression/decompression library (Drydock CVE-2026-85091 backport)"
arch="all"
license="Zlib"
url="https://zlib.net/"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="https://zlib.net/fossils/zlib-$pkgver.tar.gz
	CVE-2026-85091.patch
	write-error-state.c
	"

# secfixes:
#   1.3.2-r2026092401:
#     - CVE-2026-85091
#   1.3.2-r0:
#     - CVE-2026-22184
#     - CVE-2026-27171

build() {
	export CFLAGS="$CFLAGS -O2"
	CHOST="$CHOST" ./configure \
		--prefix=/usr \
		--shared \
		--disable-crcvx
	make
}

check() {
	make check
	${CC:-cc} -Wall -Wextra -Werror -I. "$srcdir/write-error-state.c" libz.a -o write-error-state
	./write-error-state
}

package() {
	make install DESTDIR="$pkgdir"
}

